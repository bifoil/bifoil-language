import helpers.Person
import helpers.House
import helpers.Box
import helpers.length
import helpers.nested
import helpers.checked
import helpers.keep
import helpers.inferred
import helpers.fieldLength
import helpers.nestedField
import helpers.scalarLength
scene start():
    val person = Person("Ada")
    val home = House(person)
    val first = "${length(person)}|${length(Person(null))}|${nested(home)}|${nested(House(null))}"
    val nestedBox = Box<Any?>(Box<String?>("inside"))
    val second = "${checked(person)}|${fieldLength(Box<Any?>("four"))}|${nestedField(nestedBox)}"
    val generic = "${keep(Box("kept"))}|${inferred(Box(7))}|${inferred(Box<String?>(null)) == null}"
    prose:
        ${first}|${second}|${generic}|${scalarLength("seven")}
