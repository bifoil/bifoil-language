fun make(select: Boolean) -> Int:
    val result: Int
    if select:
        initialize(1)
    else:
        initialize(1, 2)
    fun initialize(value: Int):
        result = value
    fun initialize(first: Int, second: Int):
        result = first + second
    return result
export fun run() -> () -> String:
    val first = make(true)
    val second = make(false)
    fun read() -> String = "${first}|${second}"
    return ::read
