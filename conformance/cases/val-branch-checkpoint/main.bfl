suspend fun decide() -> Boolean:
    choice:
        option "First":
            return true
        option "Second":
            return false
fun early(flag: Boolean) -> Int:
    val result: Int
    if flag:
        result = 1
        return result
    result = 2
    return result
scene start():
    val result: Int
    if decide():
        result = 10
    else:
        result = 20
    prose:
        ${result}|${early(true)}|${early(false)}
