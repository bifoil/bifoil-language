    val result1 = keep(100) %+ keep(0)
    val result2 = keep(100) %+ keep(1)
    val result3 = keep(50) %+ keep(20)
    val result4 = keep(50) %- keep(20)
    val result5 = keep(50) %+ keep(-20)
    val result6 = keep(50) %- keep(-20)
    val result7 = keep(50) %+ keep(150)
    val result8 = keep(50) %- keep(150)
