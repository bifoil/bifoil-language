export shared val trace: MutableList<Int> = []
export fun mark(value: Int) -> Int:
    trace.add(value)
    return value
export suspend fun gather(
    p00000: Int = mark(0),
    p00001: Int = mark(1),
    p00002: Int = mark(2),
    p00003: Int = mark(3),
    p00004: Int = mark(4),
    p00005: Int = mark(5),
    p00006: Int = mark(6),
    p00007: Int = mark(7),
    p00008: Int = mark(8),
    p00009: Int = mark(9),
    p00010: Int = mark(10),
    p00011: Int = mark(11),
    p00012: Int = mark(12),
    p00013: Int = mark(13),
    p00014: Int = mark(14),
    p00015: Int = mark(15),
    p00016: Int = mark(16),
    p00017: Int = mark(17),
    p00018: Int = mark(18),
    p00019: Int = mark(19),
    p00020: Int = mark(20),
    p00021: Int = mark(21),
    p00022: Int = mark(22),
    p00023: Int = mark(23),
    p00024: Int = mark(24),
    p00025: Int = mark(25),
    p00026: Int = mark(26),
    p00027: Int = mark(27),
    p00028: Int = mark(28),
    p00029: Int = mark(29),
    p00030: Int = mark(30),
    p00031: Int = mark(31),
    p00032: Int = mark(32),
    p00033: Int = mark(33),
    p00034: Int = mark(34),
    p00035: Int = mark(35),
    p00036: Int = mark(36),
    p00037: Int = mark(37),
    p00038: Int = mark(38),
    p00039: Int = mark(39)) -> Int:
    val values = [
        p00000,
        p00001,
        p00002,
        p00003,
        p00004,
        p00005,
        p00006,
        p00007,
        p00008,
        p00009,
        p00010,
        p00011,
        p00012,
        p00013,
        p00014,
        p00015,
        p00016,
        p00017,
        p00018,
        p00019,
        p00020,
        p00021,
        p00022,
        p00023,
        p00024,
        p00025,
        p00026,
        p00027,
        p00028,
        p00029,
        p00030,
        p00031,
        p00032,
        p00033,
        p00034,
        p00035,
        p00036,
        p00037,
        p00038,
        p00039,
    ]
    var total = 0
    for item in values:
        total += item
    choice:
        option "Resolved ${trace.size}":
            Unit
    return total
