export fun joined(flag: Boolean):
    if flag:
        return 1
    return 2.5
export fun forward() = anchor()
fun anchor() = 7
export fun even(value: Int) = if value == 0:
    true
else:
    odd(value - 1)
fun odd(value: Int) = if value == 0:
    false
else:
    even(value - 1)
export fun absent() = null
export fun <T> pair(first: T, second: T) = [first, second]
