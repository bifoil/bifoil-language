fun use(value: Float) -> Float = value
scene start():
    val score = if true:
        val extra = 2
        extra + 3
    else:
        1.5
    val next = use(
        if score > 4:
            7
        else:
            0.5
    )
    val continued =
        if false:
            1
        else:
            2
    prose:
        ${score === 5.0}|${next}|${continued}
