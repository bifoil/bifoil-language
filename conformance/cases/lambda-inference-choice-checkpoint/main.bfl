import helpers.pair
import helpers.chooseFirst
import helpers.chooseSecond
scene start():
    var count = 0
    val factory = pair(suspend () =>:
        count += 1
        choice:
            option "First callback":
                return ::chooseFirst
            option "Alternative":
                return ::chooseFirst
    , suspend () =>:
        count += 100
        choice:
            option "Second callback":
                return ::chooseSecond
    )
    val callback = factory()
    choice:
        option "Use callback":
            Unit
    prose:
        ${callback(3)}|${count}
