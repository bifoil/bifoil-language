export fun length(name: String?):
    if name == null:
        return 0
    return name.length
export fun textLength(input: Any):
    if input !is String:
        return 0
    return input.length
export fun reset(var name: String?):
    if name == null:
        return 0
    name = null
    return name?.length ?: 1
export fun <T> required(input: T?, alternative: T):
    if input == null:
        return alternative
    return input
export data class Reader:
    val prefix: String
    fun measure(name: String?):
        if name == null:
            return 0
        return this.prefix.length + name.length
    fun measure(value: Int) = value
