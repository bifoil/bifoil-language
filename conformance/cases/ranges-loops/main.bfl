scene start():
    var result = ""
    outer@ for i in 1..3:
        for j in 1..3:
            if j == 2:
                continue@outer
            result += String(i)
    for value in 7 downTo 1 step 3:
        result += String(value)
    var attempts = 0
    do:
        attempts += 1
        val again = attempts < 2
    while again
    var count = 0
    for maximum in 2147483646..2147483647:
        count += 1
    prose:
        ${result}|${attempts}|${count}|${3 in (1..9 step 2)}|${4 !in (1..9 step 2)}
