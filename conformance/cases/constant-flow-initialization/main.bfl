fun conditional() -> Int:
    val result: Int
    if (true):
        result = 1
    else:
        Unit
    return result
fun loop() -> Int:
    while (true):
        return 2
        break
fun traversal() -> Int:
    val result: Int
    for item in 1..2:
        result = 3
        return result
        continue
scene start():
    prose:
        ${conditional()}|${loop()}|${traversal()}
