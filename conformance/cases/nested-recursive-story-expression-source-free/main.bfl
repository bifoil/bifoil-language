import helpers.tick
import helpers.count
import helpers.ask
scene start():
    val result = 100 + (if true:
        var total = 0
        outer@ for i in 1..3:
            for j in 1..3:
                val value = 10 + ask(1)
                total += value
                if i == 1:
                    continue@outer
                break@outer
        total
    else:
        0
    )
    val atFinish = count()
    val following = tick()
    prose:
        ${result}|${atFinish}|${following}
