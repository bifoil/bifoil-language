export fun run() -> String:
    var first: Int
    for ordinal in 1..3:
        first = ordinal
    var second: Int
    for ordinal in 1..<4:
        second = ordinal
        continue
    var third: Int
    for ordinal in 5 downTo 1 step 2:
        third = ordinal
    val base: IntRange = 2..6
    var fourth: Int
    for ordinal in base step 2:
        fourth = ordinal
    return "${first}|${second}|${third}|${fourth}"
