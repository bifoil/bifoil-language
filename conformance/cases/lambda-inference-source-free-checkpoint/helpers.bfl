export fun <T> pair(left: T, right: T) -> T = left
export fun chooseFirst(value: Int) -> Int = value + 10
export fun chooseFirst(value: String) -> String = value
export fun chooseSecond(value: Int) -> Int = value + 20
export fun chooseSecond(value: Boolean) -> Boolean = value
export shared var trace: String = ""
export data class Source:
    val base: Int
    fun choose(value: Int) -> Int = base + value
    fun choose(value: String) -> String = value
