export fun run(flag: Boolean) -> () -> String:
    var result: Int
    val status = if flag:
        initialize(3)
    else:
        initialize(3, 4)
    fun initialize(value: Int) -> String:
        result = value
        return "one ${result}"
    fun initialize(value: Int, increment: Int) -> String:
        result = value + increment
        return "two ${result}"
    return () => "${status}|${result}"
