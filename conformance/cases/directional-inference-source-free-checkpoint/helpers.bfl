export shared var trace: String = ""
fun mark() -> Int:
    trace += "D"
    return 0
export data class Source:
    val base: Int
    suspend fun narrow(value: Int) -> Int:
        choice:
            option "Callback ready":
                trace += "N"
        return base + value
export fun broad(value: Int?) -> Int:
    trace += "B"
    return value ?: 0
export suspend fun <T> apply(first: suspend (T) -> Int, second: suspend (T) -> Int, value: T, ignored: Int = mark()) -> Int:
    if value is Int:
        trace += "I"
    return first(value) + second(value)
