import helpers.Box
import helpers.clear
scene start():
    val original = Box<String?>("Ada")
    val hidden: Box<*> = original
    var read: () -> Int = () => 0
    if hidden.value is String:
        read = () =>:
            if hidden.value is String:
                hidden.value.length
            else:
                -1
    clear(original)
    choice:
        option "Rechecked":
            Unit
    prose:
        ${read()}
