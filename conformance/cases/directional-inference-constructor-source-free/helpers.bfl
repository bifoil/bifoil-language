export data class Bundle<T>:
    val left: (T) -> Int
    val right: (T) -> Int
    val value: T
export sealed class Outcome<T>:
    case Value(left: (T) -> Int, right: (T) -> Int, value: T)
export typealias Alias<T> = Bundle<T>
export fun narrow(input: Int) -> Int = input
export fun broad(input: Int?) -> Int = input ?: 0
