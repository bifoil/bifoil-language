scene start():
    val first = -1.0803725086404524e-296
    val second = -1.0803725086404523e-296
    val distinct = {first, second}
    val mapping = {first: "first", second: "second"}
    choice:
        option "Inspect distinct Float keys":
            Unit
    val firstValue = mapping[first] ?: "missing"
    val secondValue = mapping[second] ?: "missing"
    prose:
        ${distinct.size}|${mapping.size}|${firstValue}|${secondValue}
