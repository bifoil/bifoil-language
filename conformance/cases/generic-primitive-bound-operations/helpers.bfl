export fun <T: Int> add(value: T) -> Int = value + 1
export fun <T: Float> half(value: T) -> Float = value / 2
export fun <T: Int> negated(value: T) -> Int = -value
export fun <T: String> append(value: T) -> String = value + '!'
export fun <T: Int> widen(value: T) -> Float = value
export fun <T: Int?> optional(value: T) -> Float? = value
export fun <T: Char> text(value: T) -> String = value
export fun <T: Int?> compare(value: T) -> Boolean = value == 1.0
export fun <T: Boolean> inverted(value: T) -> Boolean = !value
export fun <T: Boolean> condition(value: T) -> Int:
    if value:
        return 1
    return 0
export fun <T: Int> display(value: T):
    prose:
        ${value}
export suspend fun <T: Boolean> gated(value: T) -> Int:
    choice:
        option "Allowed" enabledIf value:
            return 1
        option "Other":
            return 2
