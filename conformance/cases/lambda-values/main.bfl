fun apply(value: Int, action: (Int) -> Int) = action(value)
scene start():
    var count = 0
    val double = (x: Int) => x * 2
    val saved = (x: Int) =>:
        count += 1
        if x < 0:
            return 0
        x + count
    val a = apply(3, (x: Int) =>:
        val y = x + 1
        y * 2
    )
    val sink: (Int) -> Unit = (x: Int) => count + x
    val variadic = (vararg values: Int) => values.size
    sink(4)
    prose:
        ${double(2)}|${saved(8)}|${saved(-2)}|${a}|${count}|${variadic(1, *[2, 3])}
