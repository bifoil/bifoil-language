import helpers.message
import helpers.trace
scene start():
    val text = message()
    val expected = "\n  inner\n next\n  done\n    "
    val tabs = """
	alpha
  beta
"""
    val blanks = """
    alpha
  	
    """
    val inline = """inline
    next"""
    val escapes = """
    \t\u{41}\n
"""
    prose:
        ${text == expected}|${trace}|${tabs == "\n  alpha\nbeta\n"}|${blanks == "\nalpha\n  \t\n    "}|${inline == "inline\n    next"}|${escapes == "\n\tA\n\n"}
