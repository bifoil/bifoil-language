fun make(select: Boolean) -> String:
    val result: String
    if select:
        initialize(1)
    else:
        initialize("two")
    fun initialize(value: Int):
        result = "${value}"
    fun initialize(value: String):
        result = value
    return result
export fun run() -> () -> String:
    val first = make(true)
    val second = make(false)
    fun read() -> String = "${first}|${second}"
    return ::read
