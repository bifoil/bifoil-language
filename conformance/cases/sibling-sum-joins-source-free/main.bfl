import helpers.Outcome
import helpers.Result
import helpers.choose
import helpers.paths
import helpers.rows
import helpers.generic
import helpers.many
import helpers.ask
scene start():
    val chooser: (Boolean) -> Outcome = ::choose
    val first = chooser(true)
    val second = paths(false)
    val variants = rows()
    val successful = generic<String>(true, "payload")
    val pending = generic<Int>(false, 7)
    val batch: List<Result<String>> = many("x")
    val table = {Outcome.Success("yes"): 1, Outcome.Failure(1): 2}
    val marker = table[Outcome.Failure(1)] ?: 0
    val heads = "${first is Outcome.Success}|${second is Outcome.Failure}|${variants.size}"
    val generics = "${successful is Result.Success<String>}|${pending is Result.Pending<Int>}"
    val retained = ask(false)
    val equal = Outcome.Success("yes") == Outcome.Failure(1)
    prose:
        ${heads}|${generics}|${batch.size}|${marker}|${retained is Outcome.Failure}|${equal}
