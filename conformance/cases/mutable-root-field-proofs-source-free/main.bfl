import helpers.Person
import helpers.Box
import helpers.length
import helpers.checked
import helpers.nested
import helpers.matched
import helpers.snapshot
import helpers.readAfterPause
import helpers.reader
scene start():
    val first = length(Person("Ada"))
    val missing = length(Person(null))
    val typed = checked(Box<Any?>("sixsix"))
    val deep = nested(Box<Box<String?>?>(Box<String?>("Ada")))
    val match = matched(Person("Ada"))
    val saved = reader(Person("Ada"))
    val captured = snapshot(Person("Ada"))
    val rebound = readAfterPause(Person("Ada"))
    prose:
        ${first}|${missing}|${typed}|${deep}|${match}|${captured}|${rebound}|${saved()}
