        val slot = 7
        fun read() -> Int = slot
        keep = ::read
    val slot = 9
    return keep!!
export fun disjoint(flag: Boolean) -> Int:
    var result = 0
    if flag:
        val item = 3
        result = item
    else:
        val item = 5
        result = item
    for item in 1..2:
        result += item
    val item = 10
    return result + item
