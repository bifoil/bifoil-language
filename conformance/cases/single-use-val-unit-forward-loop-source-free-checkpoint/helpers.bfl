export fun run() -> List<() -> Int>:
    val readers: MutableList<() -> Int> = mutable []
    for i in 1..2:
        val first: Int
        val second: Int
        val initialized = (initialize)()
        val observed = first + second
        fun initialize():
            first = i
            second = first + 1
        fun read() -> Int = first + second + observed
        readers.add(::read)
    return readers
