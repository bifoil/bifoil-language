export suspend fun count() -> Int:
    var visited = 0
    for point in 2147483645..2147483647 step 2:
        choice:
            option "Upper ${point}":
                Unit
        visited += 1
    for point in -2147483646 downTo -2147483648 step 2:
        choice:
            option "Lower ${point}":
                Unit
        visited += 1
    return visited
